# The R of .github/workflows/r-experiments.yml: R 4.6.2 from the same dated snapshot as oracle/Dockerfile.r46 (the R
# of the fixtures), with only the packages an outside contributor's experiment scripts may use (see
# scripts/r-experiment-check.mjs). survival is one of R's recommended packages and already present.
#
#   docker build -f oracle/Dockerfile.experiments -t rstats-experiments:4.6.2 oracle

ARG R_VERSION=4.6.2
FROM rocker/r-ver:${R_VERSION}

ARG CRAN_SNAPSHOT=2026-10-23
RUN set -e; \
    PROFILE=/usr/local/lib/R/etc/Rprofile.site; \
    sed -i "s|/cran/__linux__/resolute/[a-z0-9-]*|/cran/__linux__/resolute/${CRAN_SNAPSHOT}|g" "$PROFILE"; \
    ACTUAL=$(Rscript -e 'cat(getOption("repos")[["CRAN"]])'); \
    case "$ACTUAL" in \
      *"${CRAN_SNAPSHOT}") echo "CRAN repository: $ACTUAL" ;; \
      *) echo "failed to set the snapshot (expected ${CRAN_SNAPSHOT}, got $ACTUAL)"; exit 1 ;; \
    esac

# The versions are those of the fixtures (rstats-oracle:4.6.2); the build fails if the snapshot gives others
RUN install2.r --error --skipinstalled jsonlite cmprsk \
    && Rscript -e 'want <- c(cmprsk = "2.2.12", survival = "3.8.12"); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Sample size and power for trial designs (roadmap item 1): epiR, exact2x2, clinfun and powerSurvEpi, in a layer of
# their own, at the versions of the fixtures. epiR imports sf and flextable, whose binary packages link to GDAL, GEOS,
# PROJ, udunits and libwebpmux.
RUN apt-get update && apt-get install -y --no-install-recommends libgdal38 libgeos-c1t64 libproj25 libudunits2-0 \
        libwebpmux3 \
    && rm -rf /var/lib/apt/lists/* \
    && install2.r --error --skipinstalled epiR exact2x2 clinfun powerSurvEpi \
    && Rscript -e 'want <- c(epiR = "3.0.0", exact2x2 = "1.7.0", clinfun = "1.1.6", powerSurvEpi = "0.1.5"); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Meta-analysis: metafor and metadat (its example data), in a layer of their own, at the versions of the fixtures
RUN install2.r --error --skipinstalled metafor \
    && Rscript -e 'want <- c(metafor = "5.2.1", metadat = "1.6.0"); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Mixed models continued (roadmap item 1, 1.6.0): lme4 and its Matrix, in a layer of their own, at the versions of the
# fixtures. Matrix is one of R's recommended packages; the check fails if the snapshot's lme4 brings another.
RUN install2.r --error --skipinstalled lme4 \
    && Rscript -e 'want <- c(lme4 = "2.0.6", Matrix = "1.7.6"); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Regression (1.7.0): MASS is one of R's recommended packages and already present; the check fails if the image's
# version is not that of the fixtures (rstats-oracle:4.6.2)
RUN Rscript -e 'want <- c(MASS = "7.3.66"); \
                got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                if (!identical(unname(got), unname(want))) quit(status = 1)'

# Regression continued (1.8.0): quantreg, geepack and glmnet, in a layer of their own, at the versions of the fixtures
RUN install2.r --error --skipinstalled quantreg geepack glmnet \
    && Rscript -e 'want <- c(quantreg = "6.1", SparseM = "1.84.2", MatrixModels = "0.5.4", geepack = "1.3.13", \
                            glmnet = "5.1", Matrix = "1.7.6"); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Small tests and multivariate analysis (1.9.0): PMCMRplus (tamhaneT2Test, pageTest) and outliers (grubbs.test), in a
# layer of their own, at the versions of the fixtures. PMCMRplus imports gmp and Rmpfr, whose binary packages link to
# libgmp and libmpfr. manova and cancor are R's own (stats), lda is MASS's (above).
RUN apt-get update && apt-get install -y --no-install-recommends libmpfr6 libgmp10 \
    && rm -rf /var/lib/apt/lists/* \
    && install2.r --error --skipinstalled PMCMRplus outliers \
    && Rscript -e 'want <- c(PMCMRplus = "1.9.12", outliers = "0.15", mvtnorm = "1.4.2", multcompView = "0.1.12", \
                            gmp = "0.7.5.1", Rmpfr = "1.1.3", SuppDists = "1.1.9.9", kSamples = "1.2.12", \
                            BWStest = "0.2.3"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Correspondence analysis (1.11.0): ca (ca, mjca), in a layer of its own, at the version of the fixtures. acf, pacf
# and ccf are R's own (stats); isoMDS and sammon are MASS's (above).
RUN install2.r --error --skipinstalled ca \
    && Rscript -e 'want <- c(ca = "0.72", MASS = "7.3.66"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Propensity score matching (1.12.0): Matching (Match), cobalt (bal.tab) and tableone (CreateTableOne), in a layer of
# their own, at the versions of the fixtures. survival (clogit, coxph) is one of R's recommended packages.
RUN install2.r --error --skipinstalled Matching cobalt tableone \
    && Rscript -e 'want <- c(Matching = "4.10.15", cobalt = "5.0.0", tableone = "0.13.2"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Inverse probability of treatment weighting (1.13.0): WeightIt (weightit), CBPS (method = "cbps") and sandwich
# (vcovHC), in a layer of their own, at the versions of the fixtures. survey (svyglm) came with tableone.
RUN install2.r --error --skipinstalled WeightIt CBPS sandwich \
    && Rscript -e 'want <- c(WeightIt = "2.1.0", CBPS = "0.24", sandwich = "3.1.3", survey = "4.5"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Mediation, moderation and moderated mediation (1.16.0): mediation (mediate), interactions (sim_slopes,
# johnson_neyman) with jtools, and lmtest (coeftest), in a layer of their own, at the versions of the fixtures.
RUN install2.r --error --skipinstalled mediation interactions jtools lmtest \
    && Rscript -e 'want <- c(mediation = "4.5.1", interactions = "1.2.0", jtools = "2.3.1", lmtest = "0.9.40", MASS = "7.3.66"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Tobit and beta regression (1.17.0): AER (tobit) and betareg (with flexmix), in a layer of their own, at the
# versions of the fixtures. loglin is base R's stats; MASS (loglm) came before.
RUN install2.r --error --skipinstalled AER betareg \
    && Rscript -e 'want <- c(AER = "1.2.17", betareg = "3.2.6", Formula = "1.2.6", survival = "3.8.12", MASS = "7.3.66"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Control charts and paired comparisons (1.18.0): qcc, BradleyTerry2 (with lme4 for its random effects' data) and
# qvcalc, in a layer of their own, at the versions of the fixtures.
RUN install2.r --error --skipinstalled qcc BradleyTerry2 qvcalc \
    && Rscript -e 'want <- c(qcc = "2.7", BradleyTerry2 = "1.1.4", qvcalc = "1.0.4"); \
                   for (p in names(want)) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'

# Time-dependent ROC curves (1.19.0): timeROC (with pec and timereg) and survivalROC, in a layer of their own, at the
# versions of the fixtures.
RUN install2.r --error --skipinstalled timeROC survivalROC timereg \
    && Rscript -e 'want <- c(timeROC = "0.4.1", survivalROC = "1.0.3.1"); \
                   for (p in c(names(want), "timereg")) suppressPackageStartupMessages(library(p, character.only = TRUE)); \
                   got <- sapply(names(want), function(p) as.character(packageVersion(p))); \
                   cat(sprintf("%s %s\n", names(got), got), sep = ""); \
                   if (!identical(unname(got), unname(want))) quit(status = 1)'
